{
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./client/types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/web-config/contracts.ts"
  ],
  "exclude": ["tests", "lib", "client", "node_modules"]
}
